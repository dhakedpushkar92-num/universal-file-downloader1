# ==========================================================
# Universal File Downloader — Backend Environment Variables
# Copy this file to ".env" and fill in real values.
# NEVER commit your actual .env file to version control.
# ==========================================================

# Port the Express server listens on
PORT=5000

# Node environment: development | production
NODE_ENV=production

# Comma-separated list of allowed frontend origins for CORS
# Example: https://your-frontend.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Maximum file size the server will proxy/download, in bytes
# Default: 2147483648 = 2 GB
MAX_FILE_SIZE_BYTES=2147483648

# Timeout (ms) for the outbound HEAD/GET requests to remote hosts
REQUEST_TIMEOUT_MS=15000

# Rate limiting: max requests per IP per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Log level for winston: error | warn | info | http | debug
LOG_LEVEL=info
